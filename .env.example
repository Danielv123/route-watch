# Tailnet DNS name or organization name; '-' selects the token's tailnet.
TAILSCALE_TAILNET=-
# Scoped read-only API access token, never an auth/join key.
TAILSCALE_API_TOKEN=
# Alternative: a file containing the token (e.g. /run/secrets/tailscale_token).
TAILSCALE_API_TOKEN_FILE=
# Optional alternative to a static token: read-only OAuth client credentials.
TAILSCALE_CLIENT_ID=
TAILSCALE_CLIENT_SECRET=
TAILSCALE_CLIENT_SECRET_FILE=
# Optional role resolution (admin/owner/etc). Credential also needs users:read.
TAILSCALE_READ_USERS=false

HOST=127.0.0.1
PORT=8787
CACHE_SECONDS=60
# Exact browser hostnames allowed to access the service (no scheme or port).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional HTTP Basic authentication. Set both. Use HTTPS when accessed remotely.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_FILE=

# Prebuilt-image deployment (compose.production.yaml).
# Pin ROUTE_WATCH_IMAGE to a published sha-<commit> tag or digest for repeatability.
ROUTE_WATCH_IMAGE=ghcr.io/danielv123/route-watch:latest
BIND_ADDRESS=127.0.0.1
PUBLISHED_PORT=8787
